# ---- PostgreSQL ----
# If using Docker Compose:  postgresql://sympl:sympl_dev_pass@localhost:5432/sympl_pa
# If using a local Postgres: create the DB first, then set credentials here
#   sudo -u postgres createuser sympl --createdb --pwprompt
#   sudo -u postgres createdb sympl_pa --owner=sympl
DATABASE_URL="postgresql://sympl:your_password@localhost:5432/sympl_pa"

# ---- NextAuth ----
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Integration secrets (Salsify API key encryption at rest) ----
# Generate a strong secret:  openssl rand -base64 32
INTEGRATION_SECRET_KEY="change-me-to-a-random-string"

# ---- MS Graph API (password reset emails) ----
# Azure AD App Registration → client credentials flow
# Required permissions: Mail.Send (Application)
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_SENDER_EMAIL=""
